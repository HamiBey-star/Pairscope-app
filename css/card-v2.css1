/* PairScope card v2: presentation only. Loaded after styles.css. No markup, JS or feature changes.
   Delete this file and its <link> in index.html to roll back completely. */

/* one calmer palette + one accent (dark theme only; the light theme sets its own tokens) */
:root{--bg:#0b1220;--panel:#121b2e;--line:#22304a;--muted:#9aa7bd;--accent:#2dd4bf;--glass:#121b2e}

@media(max-width:700px){
/* card surface: flat, one border, no rainbow or medal gradients */
#body tr,
#body[data-mode="trending"] tr:nth-child(1),
#body[data-mode="trending"] tr:nth-child(2),
#body[data-mode="trending"] tr:nth-child(3){
  background:var(--panel);border:1px solid var(--line);border-radius:20px;
  padding:16px;margin-bottom:12px;box-shadow:none;
  -webkit-backdrop-filter:none;backdrop-filter:none}
#body[data-mode="trending"] tr:nth-child(1){border-color:rgba(45,212,191,.55)}

/* header row: name left, price + change right, clearer hierarchy */
#body tr .sym{font-size:17px;font-weight:700}
#body tr .q{font-size:12px}
#body tr td:nth-child(2),#body tr td:nth-child(9){font-size:16px;font-variant-numeric:tabular-nums}

/* stat labels: small, muted, aligned */
tbody tr td:nth-child(5):before,tbody tr td:nth-child(10):before,
tbody tr td:nth-child(11):before,tbody tr td:nth-child(12):before{font-size:11px;color:var(--muted)}
#body tr td{font-variant-numeric:tabular-nums}

/* sparkline: a little taller, rounded line */
#body tr .hv-sp,.spk svg{height:48px}
#body tr .hv-sp polyline,#body tr .hv-sp path,.spk svg polyline{stroke-linecap:round;stroke-linejoin:round}

/* security chips (inline-styled): smaller, quieter pills */
#body tr .pxg span{font-size:12px!important;font-weight:600;padding:4px 9px!important;border-radius:10px!important;background:rgba(255,255,255,.04)!important}

/* stats strip (FDV / Age / Txns) */
#body tr .pxh{display:flex;flex-wrap:wrap;gap:6px 14px;font-size:12px;color:var(--muted)}
#body tr .pxh b{color:var(--text);font-weight:600}

/* timeframe chips: real touch targets, one accent for the selected one */
#body tr .pxt button{min-height:44px;border-radius:12px;border:1px solid var(--line);background:var(--bg);color:var(--muted);font-size:14px}
#body tr .pxt button.on{border-color:var(--accent);background:rgba(45,212,191,.14);color:var(--accent);font-weight:600}

/* buys / sells bar: thin, rounded */
#body tr .pxb{height:6px;border-radius:3px;overflow:hidden}
#body tr .pxl{font-size:12px;color:var(--muted)}

/* actions: primary + secondary */
#body tr .pxa a{min-height:44px;display:inline-flex;align-items:center;justify-content:center;border-radius:12px}
#body tr .pp-buy{min-height:44px;border-radius:12px;border:0;background:var(--accent);color:#06231f;font-weight:700}

/* copy-address pill */
tbody tr td:nth-child(13) [data-ca]{background:var(--bg);border-color:var(--line);border-radius:12px}

/* bottom nav: fixes every tab showing as selected; only the current tab is highlighted */
#psnav{background:rgba(18,27,46,.92);border:1px solid var(--line)}
#psnav button:not(.on){color:var(--muted);background:none}
#psnav button.on{color:var(--accent);background:rgba(45,212,191,.14)}
}

/* ---- safety ring (markup from card-extras.js) ---- */
.pxsf{display:flex;align-items:center;gap:14px;padding:12px;margin:0 0 10px;border-radius:16px;background:var(--bg)}
.pxsf svg{flex:none}
.pxsf text{fill:currentColor;font-family:inherit}
.pxsf-t{stroke:var(--line)}
.pxsf-g{color:var(--up)}.pxsf-y{color:#f5c542}.pxsf-r{color:var(--down)}
.pxsf-v{stroke:currentColor}
.pxsf-x{display:flex;flex-direction:column;gap:2px;min-width:0}
.pxsf-x b{font-size:15px;font-weight:700;color:currentColor}
.pxsf-x span{font-size:12px;color:var(--muted)}

@media(max-width:700px){
/* the ring replaces the small Risk cell on phones (data and sorting unchanged) */
tbody tr td:nth-child(12){display:none}

/* community reactions: same buttons and votes, quieter and evenly spaced; zero counts dimmed */
.rx-bar{gap:8px;margin-top:10px}
.rx{flex:1;min-height:44px;border-radius:12px;background:var(--bg);border:1px solid var(--line);color:var(--text);font-size:14px}
.rx b{font-weight:600;font-variant-numeric:tabular-nums}
.rx.z{opacity:.55}
.rx.on{opacity:1;border-color:var(--accent);background:rgba(45,212,191,.14);box-shadow:none}
}

/* nav: every tab is a visible pill; the current tab is stronger */
@media(max-width:700px){
#psnav{gap:4px;padding:6px}
#psnav button{flex:1;min-width:0;padding:6px 2px;border-radius:14px;font-size:11.5px}
#psnav button:not(.on){color:#c3cde0;background:rgba(45,212,191,.08);box-shadow:inset 0 0 0 1px rgba(45,212,191,.28)}
#psnav button:not(.on) i{color:var(--accent);filter:none}
#psnav button.on{color:var(--accent);background:rgba(45,212,191,.24);box-shadow:inset 0 0 0 2px var(--accent);font-weight:700}
#psnav button.on i{color:var(--accent);filter:none}
}
